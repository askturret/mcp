{
  "name": "@askturret/mcp",
  "version": "0.1.2",
  "private": true,
  "description": "Agent-facing API layer - discover, shape, govern, and serve operations through Model Context Protocol",
  "type": "module",
  "bin": {
    "askturret-mcp": "./packages/cli/dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./packages/core/dist/index.d.ts",
      "import": "./packages/core/dist/index.js"
    },
    "./openapi": {
      "types": "./packages/sources-openapi/dist/index.d.ts",
      "import": "./packages/sources-openapi/dist/index.js"
    },
    "./express": {
      "types": "./packages/adapters-express/dist/index.d.ts",
      "import": "./packages/adapters-express/dist/index.js"
    },
    "./fastify": {
      "types": "./packages/adapters-fastify/dist/index.d.ts",
      "import": "./packages/adapters-fastify/dist/index.js"
    },
    "./otel": {
      "types": "./packages/observability/dist/index.d.ts",
      "import": "./packages/observability/dist/index.js"
    },
    "./policies": {
      "types": "./packages/core/dist/policy/index.d.ts",
      "import": "./packages/core/dist/policy/index.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "prepublishOnly": "node -e \"console.error('\\nREFUSED: the repository root is not a publishable package.\\n\\n  It has no build output of its own - its exports map points at ./packages/*/dist,\\n  which resolves to nothing outside this workspace - and publishing it would ship\\n  the entire repository, including .github/ and .operum/, to a public registry\\n  under an immutable version (#591).\\n\\n  To release the packages:  npm publish --workspaces\\n\\n  private:true does NOT stop this on its own: npm gates that check on\\n  `workspace && manifest.private`, so a bare root publish skips it. This script\\n  is what actually refuses.\\n'); process.exit(1)\"",
    "build": "tsc -b",
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "tsc -b",
    "test:conformance": "node packages/adapter-conformance/bin/run.mjs",
    "check:workspace-artifacts": "node .github/scripts/check-workspace-artifacts.mjs ."
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "agents",
    "openapi",
    "api-gateway"
  ],
  "author": "AskTurret",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/askturret/mcp.git"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0",
    "fastify": "^4.0.0 || ^5.0.0",
    "@modelcontextprotocol/sdk": "^1.24.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": false
    }
  }
}
