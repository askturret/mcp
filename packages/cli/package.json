{
  "name": "@askturret/mcp-cli",
  "version": "0.1.0",
  "description": "CLI tools - doctor, inspect, diff",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "turret": "./dist/cli.js"
  },
