{
  "name": "@askturret/mcp-sources-openapi",
  "version": "0.1.0",
  "description": "OpenAPI import source adapter",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "npm test -- --watch",
    "lint": "echo \"Linting not yet configured\""
  },
  "dependencies": {
    "@askturret/mcp-core": "^0.1.0",
    "@apidevtools/swagger-parser": "^10.1.0",
    "openapi-types": "^12.1.3"
  },
  "devDependencies": {
    "typescript": "*",
    "@types/node": "^20.14.0",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0"
  },
  "files": [
    "dist",
    "!dist/**/__tests__/**",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "askturret",
    "mcp",
    "server",
    "client"
  ]
}
